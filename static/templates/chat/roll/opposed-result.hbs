<div class="wfrp4e chat-card">
    <div class="opposed-card">
        <div>
            {{{result}}}
        </div>
        {{#if resolution}}
        <details class="opposed-resolution">
            <summary>{{localize "BREAKDOWN.Explanation"}}</summary>
            <p>{{localize "BREAKDOWN.AttackerSL"}}: {{resolution.originalAttackerSL}} → {{resolution.attackerSL}}</p>
            <p>{{localize "BREAKDOWN.DefenderSL"}}: {{resolution.originalDefenderSL}} → {{resolution.defenderSL}}</p>
            {{#each resolution.notes}}
            <p>{{this}}</p>
            {{/each}}
            <p>{{localize resolution.reason}}</p>
        </details>
        {{/if}}
        <div>
            {{{damage.description}}}
            {{#if breakdown.formatted}}
            <a class="opposed-breakdown"  style="opacity: 0.5" data-tooltip="{{breakdown.formatted}}" data-tooltip-direction="LEFT" ><i class="fa-solid fa-circle-info"></i></a>
            {{/if}}
        </div>
        <div>
            {{{hitloc.description}}}
        </div>
        {{#each other as |string index|}}
        <div>
            {{{string}}}
        </div>
        {{/each}}
        {{#if damage}}
            {{#unless confirmation}}
            <button class='chat-button' data-action="applyDamage">{{localize "CHATOPT.ApplyDamage"}}</button>
            {{/unless}}
        {{/if}}
        {{#if confirmation}}
            {{{confirmation}}}
        {{/if}}
        {{#if showDualWielding}}
            <p><button class='chat-button' data-action="rollDualWielder">{{#if dualWieldCostsMomentum}}{{localize "FIFTHED.DualWieldMomentum"}}{{else}}Roll Dual Wielder Attack{{/if}}</button></p>
        {{/if}}
            {{#each actions}}
                <button class="chat-button" type="button"
                data-action="executeAction"
                data-effect-path="{{this.effectPath}}" 
                data-effect-id="{{this.effectId}}" 
                data-script-index="{{this.scriptIndex}}" 
                data-action-index="{{@key}}" 
                data-item-uuid="{{this.itemUuid}}">
                {{this.label}}
                </button>
        {{/each}}
    </div>
</div>